# Copie para .env (local) ou cadastre como variáveis de ambiente na hospedagem.
# Nunca publique o .env com as chaves reais.

# API Futebol (oficial): campeonatos do seu plano e notícias
FUTEBOL_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# football-data.org: Champions e ligas europeias (plano gratuito: 10 requisições/min)
FOOTBALL_DATA_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ESPN (pública, não oficial): cobre o que os planos não cobrem e o placar ao vivo. 0 desliga.
ESPN_FALLBACK=1

# Servidor
PORT=8080
HOST=0.0.0.0
# Pasta para cache e contador do orçamento diário (use um disco persistente na hospedagem)
DATA_DIR=
# Atrás do proxy da hospedagem (Render, Railway, Fly, Nginx): 1 usa o IP real do visitante
TRUST_PROXY=1
# Limites por visitante (requisições por minuto)
RATE_API_MIN=240
RATE_HEAVY_MIN=20
# Protege /api/_status: acesse /api/_status?token=SEU_TOKEN
STATUS_TOKEN=
# Log: api (padrão) | all | off
LOG_LEVEL=api

# ---------------------------------------------------------------- Contas (login)
# Endereço público do site, sem barra no fim (obrigatório em produção: links dos e-mails e retorno do Google)
PUBLIC_URL=
# Chave para assinar o captcha. Se vazio, uma chave aleatória é criada em DATA_DIR/secret.key
SECRET_KEY=

# Login com Google: console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <PUBLIC_URL>/api/auth/google/retorno  (local: http://localhost:8080/api/auth/google/retorno)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Captcha: sem nada aqui, usa o captcha próprio (prova de trabalho, sem serviços de terceiros).
# Para usar o Cloudflare Turnstile (dash.cloudflare.com > Turnstile), preencha as duas chaves:
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Dificuldade do captcha próprio (maior = mais lento para robôs e para pessoas)
CAPTCHA_DIFICULDADE=60000

# E-mail (confirmação de conta e "esqueci minha senha"). Sem SMTP, os links aparecem no log do servidor.
# Ex.: Gmail com senha de app: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vyra <no-reply@seudominio.com>
# ---------------------------------------------------------------- IA
# GRÁTIS (padrão): Gemini, do Google. Chave em https://aistudio.google.com/apikey (conta Google, sem cartão).
# No plano grátis o Google pode usar o que é enviado para melhorar os produtos (a Vyra só envia dados públicos de futebol).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Teto de chamadas por dia à IA na nuvem (protege a cota grátis do Gemini e o custo da Anthropic)
AI_DAILY_REQUESTS=400
# PAGO (opcional): Claude, da Anthropic. Com a chave preenchida, passa a ser o provedor.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# LOCAL (opcional, pesado): AI_PROVIDER=ollama usa o Ollama no próprio computador (precisa de placa de vídeo ou muita RAM)
AI_PROVIDER=
OLLAMA_MODEL=qwen3:4b
# 0 desliga a IA
AI_ENABLED=1
# ---------------------------------------------------------------- Estádio (aba "Clube" do time)
# Foto, vista aérea 3D e dados vêm da Wikipédia/Wikidata e do satélite da Esri: grátis, sem chave.
# Opcional: Street View 360° do estádio. Crie uma chave da "Maps Embed API" (grátis e sem limite) em
# console.cloud.google.com e RESTRINJA a chave ao seu domínio (referenciadores HTTP) e só à Maps Embed API:
# ela vai dentro do endereço do iframe, então quem abrir o site consegue vê-la.
GOOGLE_MAPS_EMBED_KEY=
